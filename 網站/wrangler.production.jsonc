// 音藏正式環境（Cloudflare Workers，yinzang.dblzm.workers.dev）。
// 只有 scripts/deploy.sh 會用（YINZANG_DEPLOY=production）。本機 dev 不讀這份。
// 已填（2026-09-27 首次部署）：account_id、database_id、TURNSTILE_SITE_KEY；雜湊次數依使用者決定用 5 萬次。步驟見 產出/20260927_部署手冊.md
// 密鑰一律 `wrangler secret put`，不寫在這裡：TURNSTILE_SECRET、RESEND_API_KEY、BUDGET_WEBHOOK_SECRET
{
  "name": "yinzang",
  "main": "./worker.ts",
  // 部署版本號：整頁快取的鍵含這個，新部署不會拿到舊版 HTML（worker.ts）
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "48743ee150caa3577d8abd6e99196709",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yinzang",
      "database_id": "d70c8f5e-6d9b-4f62-ad21-571d0c827819",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "yinzang-photos" }],
  // 每天一次，資料保存期限清理（上線後雜項，2026-09-28）：user_activity／user_geo／rate_limits 超過 90 天的列清掉
  // （lib/server/cleanup.ts、worker.ts 的 scheduled）。18:00 UTC＝台灣時間凌晨 2 點，流量低。
  // Cron Trigger 免費方案可用（同一個 Worker 最多 5 條），不用升級。
  "triggers": { "crons": ["0 18 * * *"] },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFEx6pj-sHlnKx92",
    "ADMIN_EMAILS": "zukawork0312@gmail.com",
    "ALLOW_INDEXING": "0",
    "PBKDF2_ITERATIONS": "50000",
    // 管理後台用量頁查 Cloudflare GraphQL 用（不是密鑰）；金鑰另外用 secret CF_ANALYTICS_TOKEN，沒設顯示「未設定」
    "CF_ACCOUNT_ID": "48743ee150caa3577d8abd6e99196709"
  },
  "observability": { "enabled": true }
}
