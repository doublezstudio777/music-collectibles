// 樂迷藏正式環境（Cloudflare Workers：正式網域 lemibox.com。舊網址 yinzang.dblzm.workers.dev 2026-10-01 關閉，見 workers_dev）。
// 只有 scripts/deploy.sh 會用（YINZANG_DEPLOY=production）。本機 dev 不讀這份。
// 已填（2026-09-27 首次部署）：account_id、database_id、TURNSTILE_SITE_KEY；雜湊次數依使用者決定用 5 萬次。步驟見 產出/20260927_部署手冊.md
// 密鑰一律 `wrangler secret put`，不寫在這裡：TURNSTILE_SECRET、RESEND_API_KEY、BUDGET_WEBHOOK_SECRET、SPOTIFY_CLIENT_ID、SPOTIFY_CLIENT_SECRET
{
  "name": "yinzang",
  "main": "./worker.ts",
  // 部署版本號：整頁快取的鍵含這個，新部署不會拿到舊版 HTML（worker.ts）
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "48743ee150caa3577d8abd6e99196709",
  // 2026-10-01 使用者決定關閉舊網址（不轉址）：workers.dev 子網域不再服務，只剩 lemibox.com。deploy.sh 會斷言舊網址不能用
  "workers_dev": false,
  "preview_urls": false,
  // 正式網域（2026-09-30）：apex 與 www 都是 Custom Domain 綁這個 Worker，www 由 worker.ts 301 到 apex。
  // 寫在這裡讓 wrangler deploy 維持綁定；DNS 與憑證由 Cloudflare 自動管理（帳號金鑰沒有 DNS 權限也能綁）
  "routes": [
    { "pattern": "lemibox.com", "custom_domain": true },
    { "pattern": "www.lemibox.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yinzang",
      "database_id": "d70c8f5e-6d9b-4f62-ad21-571d0c827819",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "yinzang-photos" }],
  // 每天一次，資料保存期限清理（上線後雜項，2026-09-28）：user_activity／user_geo／rate_limits 超過 90 天的列清掉
  // （lib/server/cleanup.ts、worker.ts 的 scheduled）。18:00 UTC＝台灣時間凌晨 2 點，流量低。
  // Cron Trigger 免費方案可用（同一個 Worker 最多 5 條），不用升級。
  // Spotify 自動抽歌（2026-09-30）：台灣時間 02:00～04:55 每 5 分鐘一批（lib/server/spotify-draw.ts）。worker.ts 用 event.cron 分辨兩條
  // 發布時自動補資料（2026-09-30）：每 10 分鐘接手背景沒跑完的查詢（lib/server/autofill.ts），沒工作時只查一次 D1
  "triggers": { "crons": ["0 18 * * *", "*/5 18-20 * * *", "*/10 * * * *"] },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFEx6pj-sHlnKx92",
    "ADMIN_EMAILS": "zukawork0312@gmail.com",
    // 搜尋引擎收錄：2026-10-02 用戶核准開放（0→1）。改回 0＝全站 noindex、robots.txt 不附 sitemap
    "ALLOW_INDEXING": "1",
    "PBKDF2_ITERATIONS": "50000",
    // 管理後台用量頁查 Cloudflare GraphQL 用（不是密鑰）；金鑰另外用 secret CF_ANALYTICS_TOKEN，沒設顯示「未設定」
    "CF_ACCOUNT_ID": "48743ee150caa3577d8abd6e99196709"
  },
  "observability": { "enabled": true }
}
